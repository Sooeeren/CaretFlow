# Arch Linux package for CaretFlow (formerly Folio), repackaged from the release .deb (same binary,
# icons and .desktop file). The release workflow sets the version and checksum and attaches the built
# package to each release; the same file works for the AUR. Install a release file with:
#   sudo pacman -U ./caretflow-bin-<version>-1-x86_64.pkg.tar.zst
pkgname=caretflow-bin
_ver=0.6.1 # CaretFlow's version; pkgver can't contain '-'
pkgver=${_ver//-/_}
pkgrel=1
pkgdesc='A fast, seamless Markdown reader & editor (formerly Folio)'
arch=('x86_64')
url='https://github.com/Sooeeren/CaretFlow'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
optdepends=('xdg-desktop-portal: native file dialogs')
provides=('caretflow')
conflicts=('caretflow' 'folio-bin')
replaces=('folio-bin')
options=('!strip' '!debug')
source=("https://github.com/Sooeeren/CaretFlow/releases/download/v${_ver}/CaretFlow_${_ver}_amd64.deb")
sha256sums=('38c0e653062525136ba459eccce43a1a592a45f38ab563393278db55074d3cd1')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  chmod 755 "$pkgdir/usr/bin/caretflow"
}
